<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Monkey World | Explore the Primate Kingdom</title>

    <meta name="description"
          content="Explore the fascinating world of monkeys through facts, species information and interactive quizzes.">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Inter, Arial, Helvetica, sans-serif;
            color: #fff;
            background: #07140d;
            overflow-x: hidden;
        }

        /* =========================
           BACKGROUND
        ========================= */

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            z-index: -3;

            background:
                linear-gradient(
                    rgba(2, 20, 11, 0.72),
                    rgba(2, 20, 11, 0.90)
                ),
                url("https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTLh-zhEqgezfM8iIm1yztPEFNOGt_TVvC4gwh9gMxJuQ&s=10")
                center / cover no-repeat;

            transform: scale(1.04);
        }

        body::after {
            content: "";
            position: fixed;
            inset: 0;
            z-index: -2;

            background:
                radial-gradient(
                    circle at 15% 15%,
                    rgba(77, 255, 137, 0.13),
                    transparent 30%
                ),
                radial-gradient(
                    circle at 90% 80%,
                    rgba(255, 188, 79, 0.10),
                    transparent 35%
                );
        }

        /* =========================
           NAVIGATION
        ========================= */

        nav {
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1000;

            padding: 18px 6%;

            display: flex;
            align-items: center;
            justify-content: space-between;

            background: rgba(4, 18, 10, 0.55);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;

            font-size: 1.35rem;
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        .logo-icon {
            width: 38px;
            height: 38px;

            display: grid;
            place-items: center;

            border-radius: 12px;
            background: linear-gradient(135deg, #8eea62, #28a957);

            font-size: 21px;
            box-shadow: 0 8px 25px rgba(60, 200, 90, .25);
        }

        nav ul {
            display: flex;
            gap: 30px;
            list-style: none;
        }

        nav a {
            color: rgba(255,255,255,.8);
            text-decoration: none;
            font-size: .95rem;
            font-weight: 600;

            transition: .25s;
        }

        nav a:hover {
            color: #9cff6e;
        }

        /* =========================
           HERO
        ========================= */

        .hero {
            min-height: 100vh;

            display: flex;
            align-items: center;

            padding: 130px 8% 80px;
        }

        .hero-content {
            max-width: 850px;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;

            padding: 9px 15px;

            border: 1px solid rgba(156,255,110,.25);
            background: rgba(75,180,90,.10);

            border-radius: 999px;

            color: #aaff83;
            font-size: .85rem;
            font-weight: 700;

            margin-bottom: 25px;
        }

        .hero h1 {
            font-size: clamp(3.2rem, 8vw, 7rem);
            line-height: .95;
            letter-spacing: -5px;

            margin-bottom: 28px;
        }

        .hero h1 span {
            color: #a1ff72;

            text-shadow:
                0 0 40px rgba(125,255,93,.25);
        }

        .hero p {
            max-width: 650px;

            color: rgba(255,255,255,.75);

            font-size: 1.15rem;
            line-height: 1.8;

            margin-bottom: 35px;
        }

        .hero-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;

            padding: 14px 22px;

            border-radius: 13px;

            text-decoration: none;
            font-weight: 800;

            transition: .3s;
        }

        .btn-primary {
            color: #07140d;
            background: #a1ff72;

            box-shadow:
                0 10px 35px rgba(112, 255, 93, .20);
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            background: #baff96;
        }

        .btn-secondary {
            color: #fff;

            background: rgba(255,255,255,.07);
            border: 1px solid rgba(255,255,255,.14);

            backdrop-filter: blur(10px);
        }

        .btn-secondary:hover {
            transform: translateY(-3px);
            background: rgba(255,255,255,.12);
        }

        /* =========================
           GENERAL SECTIONS
        ========================= */

        section {
            padding: 110px 7%;
        }

        .section-header {
            max-width: 750px;
            margin-bottom: 50px;
        }

        .section-label {
            color: #9cff6e;
            font-size: .78rem;
            font-weight: 900;

            text-transform: uppercase;
            letter-spacing: 2px;

            margin-bottom: 12px;
        }

        .section-header h2 {
            font-size: clamp(2.2rem, 5vw, 4rem);
            line-height: 1;

            letter-spacing: -2px;

            margin-bottom: 18px;
        }

        .section-header p {
            color: rgba(255,255,255,.65);
            line-height: 1.8;
        }

        /* =========================
           INFO CARDS
        ========================= */

        .species-grid {
            display: grid;

            grid-template-columns:
                repeat(auto-fit, minmax(230px, 1fr));

            gap: 20px;
        }

        .glass-card {
            padding: 28px;

            border-radius: 22px;

            background: rgba(9, 30, 17, .58);

            border: 1px solid rgba(255,255,255,.10);

            backdrop-filter: blur(18px);

            box-shadow:
                0 20px 60px rgba(0,0,0,.18);

            transition:
                transform .3s,
                border-color .3s,
                background .3s;
        }

        .glass-card:hover {
            transform: translateY(-8px);

            border-color:
                rgba(157,255,111,.35);

            background:
                rgba(16, 48, 25, .72);
        }

        .card-icon {
            width: 55px;
            height: 55px;

            display: grid;
            place-items: center;

            border-radius: 16px;

            background:
                rgba(158,255,111,.12);

            font-size: 27px;

            margin-bottom: 22px;
        }

        .glass-card h3 {
            margin-bottom: 12px;
            font-size: 1.3rem;
        }

        .glass-card p {
            color: rgba(255,255,255,.63);
            line-height: 1.7;
            font-size: .95rem;
        }

        /* =========================
           FACT OF THE DAY
        ========================= */

        .fact-box {
            display: grid;
            grid-template-columns: 100px 1fr;
            gap: 25px;

            align-items: center;

            padding: 35px;

            border-radius: 25px;

            background:
                linear-gradient(
                    135deg,
                    rgba(143,255,100,.13),
                    rgba(255,255,255,.04)
                );

            border:
                1px solid rgba(158,255,111,.18);

            backdrop-filter: blur(15px);
        }

        .fact-number {
            width: 80px;
            height: 80px;

            display: grid;
            place-items: center;

            border-radius: 22px;

            background: #a1ff72;

            color: #08150d;

            font-size: 2rem;
        }

        .fact-box h3 {
            margin-bottom: 8px;
        }

        .fact-box p {
            color: rgba(255,255,255,.72);
            line-height: 1.7;
        }

        /* =========================
           QUIZ
        ========================= */

        .quiz-wrapper {
            max-width: 850px;
            margin: auto;

            padding: 35px;

            border-radius: 28px;

            background:
                rgba(5, 24, 13, .72);

            border:
                1px solid rgba(255,255,255,.10);

            backdrop-filter: blur(20px);

            box-shadow:
                0 30px 100px rgba(0,0,0,.25);
        }

        .quiz-top {
            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 20px;

            margin-bottom: 20px;
        }

        .quiz-count {
            color: #a1ff72;
            font-weight: 800;
        }

        .progress {
            height: 8px;

            background: rgba(255,255,255,.08);

            border-radius: 99px;

            overflow: hidden;

            margin-bottom: 35px;
        }

        .progress-bar {
            width: 0%;
            height: 100%;

            background:
                linear-gradient(
                    90deg,
                    #61dc54,
                    #c0ff78
                );

            transition: width .4s ease;
        }

        .question {
            font-size: clamp(1.5rem, 3vw, 2.2rem);
            line-height: 1.3;

            margin-bottom: 25px;
        }

        .answers {
            display: grid;
            gap: 12px;
        }

        .answer {
            width: 100%;

            text-align: left;

            padding: 17px 18px;

            color: #fff;

            border:
                1px solid rgba(255,255,255,.10);

            background:
                rgba(255,255,255,.045);

            border-radius: 14px;

            cursor: pointer;

            font-size: 1rem;
            font-weight: 600;

            transition: .25s;
        }

        .answer:hover:not(:disabled) {
            background:
                rgba(158,255,111,.10);

            border-color:
                rgba(158,255,111,.3);

            transform: translateX(4px);
        }

        .answer.correct {
            background: rgba(76,220,93,.18);
            border-color: #69e95f;
            color: #baffab;
        }

        .answer.wrong {
            background: rgba(255,77,77,.15);
            border-color: #ff6969;
            color: #ffb0b0;
        }

        .quiz-footer {
            margin-top: 25px;

            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        #quiz-message {
            color: rgba(255,255,255,.65);
            font-size: .9rem;
        }

        .next-btn {
            border: 0;
            cursor: pointer;

            padding: 13px 20px;

            border-radius: 12px;

            background: #a1ff72;
            color: #07140d;

            font-weight: 900;

            display: none;
        }

        .result {
            display: none;
            text-align: center;
            padding: 30px 0 10px;
        }

        .result-emoji {
            font-size: 4rem;
            margin-bottom: 15px;
        }

        .score {
            font-size: 4rem;
            font-weight: 900;
            color: #a1ff72;
            margin: 10px 0;
        }

        /* =========================
           MONKEY FACTS
        ========================= */

        .random-fact {
            text-align: center;
            max-width: 750px;
            margin: auto;
        }

        .random-fact p {
            font-size: 1.4rem;
            line-height: 1.7;

            color: rgba(255,255,255,.82);

            min-height: 90px;
        }

        /* =========================
           FOOTER
        ========================= */

        footer {
            padding: 45px 7%;

            border-top:
                1px solid rgba(255,255,255,.08);

            background:
                rgba(0,0,0,.28);

            text-align: center;
        }

        footer p {
            color: rgba(255,255,255,.45);
            font-size: .9rem;
        }

        footer strong {
            color: #a1ff72;
        }

        /* =========================
           ANIMATIONS
        ========================= */

        .fade-in {
            animation: fadeIn 1s ease both;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* =========================
           MOBILE
        ========================= */

        @media (max-width: 700px) {

            nav {
                padding: 14px 5%;
            }

            nav ul {
                display: none;
            }

            .hero {
                padding-left: 6%;
                padding-right: 6%;
            }

            .hero h1 {
                letter-spacing: -3px;
            }

            section {
                padding: 80px 6%;
            }

            .fact-box {
                grid-template-columns: 1fr;
            }

            .quiz-wrapper {
                padding: 23px;
            }

            .quiz-top {
                align-items: flex-start;
                flex-direction: column;
            }
        }
    </style>
</head>

<body>

    <!-- =========================
         NAVIGATION
    ========================== -->

    <nav>
        <div class="logo">
            <div class="logo-icon">🐒</div>
            Monkey World
        </div>

        <ul>
            <li><a href="#explore">Explore</a></li>
            <li><a href="#facts">Facts</a></li>
            <li><a href="#quiz">Quiz</a></li>
        </ul>
    </nav>


    <!-- =========================
         HERO
    ========================== -->

    <header class="hero">

        <div class="hero-content fade-in">

            <div class="eyebrow">
                🌿 Discover the Primate Kingdom
            </div>

            <h1>
                Welcome to the
                <span>Monkey World.</span>
            </h1>

            <p>
                Step into the fascinating world of monkeys.
                Discover incredible species, learn surprising facts,
                and test your knowledge with our interactive quiz.
            </p>

            <div class="hero-buttons">

                <a href="#explore" class="btn btn-primary">
                    Explore Monkeys →
                </a>

                <a href="#quiz" class="btn btn-secondary">
                    Take the Quiz 🧠
                </a>

            </div>

        </div>

    </header>


    <!-- =========================
         EXPLORE
    ========================== -->

    <section id="explore">

        <div class="section-header">

            <div class="section-label">
                Explore
            </div>

            <h2>
                Meet some incredible monkeys.
            </h2>

            <p>
                Monkeys are remarkably diverse animals found across
                tropical and subtropical regions around the world.
                Here are a few fascinating examples.
            </p>

        </div>


        <div class="species-grid">

            <article class="glass-card">

                <div class="card-icon">
                    🐒
                </div>

                <h3>Capuchin</h3>

                <p>
                    Capuchin monkeys are highly intelligent primates
                    known for their curiosity, dexterity and complex
                    social behavior.
                </p>

            </article>


            <article class="glass-card">

                <div class="card-icon">
                    🌳
                </div>

                <h3>Spider Monkey</h3>

                <p>
                    Spider monkeys have long limbs and prehensile tails
                    that help them move through the forest canopy.
                </p>

            </article>


            <article class="glass-card">

                <div class="card-icon">
                    👑
                </div>

                <h3>Howler Monkey</h3>

                <p>
                    Howler monkeys are famous for their incredibly loud
                    calls, which can travel through dense forests.
                </p>

            </article>


            <article class="glass-card">

                <div class="card-icon">
                    🌿
                </div>

                <h3>Squirrel Monkey</h3>

                <p>
                    Squirrel monkeys are small, energetic primates that
                    often live in large social groups.
                </p>

            </article>

        </div>

    </section>


    <!-- =========================
         FACT
    ========================== -->

    <section id="facts">

        <div class="section-header">

            <div class="section-label">
                Did You Know?
            </div>

            <h2>
                One tiny fact can change how you see them.
            </h2>

        </div>


        <div class="fact-box">

            <div class="fact-number">
                🧠
            </div>

            <div>

                <h3>
                    Monkey intelligence
                </h3>

                <p>
                    Many monkey species can learn from experience,
                    remember locations, communicate socially and
                    manipulate objects with impressive dexterity.
                </p>

            </div>

        </div>

    </section>


    <!-- =========================
         RANDOM FACT
    ========================== -->

    <section>

        <div class="random-fact">

            <div class="section-label">
                Random Fact Generator
            </div>

            <p id="randomFact">
                Click the button to discover a monkey fact!
            </p>

            <button
                class="btn btn-primary"
                onclick="generateFact()">
                🐒 Give Me a Fact
            </button>

        </div>

    </section>


    <!-- =========================
         QUIZ
    ========================== -->

    <section id="quiz">

        <div class="section-header">

            <div class="section-label">
                Interactive Quiz
            </div>

            <h2>
                How much do you know about monkeys?
            </h2>

            <p>
                Test your knowledge. Choose the answer you think is
                correct and see how high you can score.
            </p>

        </div>


        <div class="quiz-wrapper">

            <div class="quiz-top">

                <span class="quiz-count" id="quizCount">
                    Question 1 of 6
                </span>

                <span id="scoreDisplay">
                    Score: 0
                </span>

            </div>


            <div class="progress">
                <div
                    class="progress-bar"
                    id="progressBar">
                </div>
            </div>


            <div id="quizContent">

                <div
                    class="question"
                    id="question">
                </div>

                <div
                    class="answers"
                    id="answers">
                </div>

                <div class="quiz-footer">

                    <span id="quizMessage">
                        Select an answer.
                    </span>

                    <button
                        class="next-btn"
                        id="nextButton"
                        onclick="nextQuestion()">
                        Next →
                    </button>

                </div>

            </div>


            <div class="result" id="result">

                <div class="result-emoji">
                    🐒
                </div>

                <h2>
                    Quiz Complete!
                </h2>

                <div
                    class="score"
                    id="finalScore">
                    0/6
                </div>

                <p id="resultText"></p>

                <br>

                <button
                    class="btn btn-primary"
                    onclick="restartQuiz()">
                    Try Again
                </button>

            </div>

        </div>

    </section>


    <!-- =========================
         FOOTER
    ========================== -->

    <footer>

        <p>
            Built with curiosity, code &amp; 🐒 by
            <strong>Monkey World</strong>
        </p>

        <br>

        <p>
            Explore. Learn. Protect wildlife.
        </p>

    </footer>


    <!-- =========================
         JAVASCRIPT
    ========================== -->

    <script>

        /* ==================================
           RANDOM MONKEY FACTS
        ================================== */

        const monkeyFacts = [

            "Some monkeys use tools to help them access food.",

            "Howler monkeys have some of the loudest calls among land animals.",

            "Spider monkeys use their long, flexible tails to help move through trees.",

            "Capuchin monkeys are known for their impressive problem-solving abilities.",

            "Many monkeys live in groups called troops.",

            "Some monkeys communicate using facial expressions, body movements and sounds.",

            "Squirrel monkeys are particularly agile and spend much of their time in trees.",

            "Monkeys can have complex social relationships within their groups."

        ];


        function generateFact() {

            const fact =
                monkeyFacts[
                    Math.floor(
                        Math.random() * monkeyFacts.length
                    )
                ];

            const element =
                document.getElementById("randomFact");

            element.style.opacity = "0";

            setTimeout(() => {

                element.textContent = fact;

                element.style.opacity = "1";

            }, 150);

        }


        /* ==================================
           QUIZ DATA
        ================================== */

        const questions = [

            {
                question:
                    "What is a group of monkeys commonly called?",

                answers: [
                    "A troop",
                    "A pack",
                    "A herd",
                    "A flock"
                ],

                correct: 0
            },


            {
                question:
                    "Which monkey is famous for its extremely loud call?",

                answers: [
                    "Spider monkey",
                    "Howler monkey",
                    "Squirrel monkey",
                    "Tamarin"
                ],

                correct: 1
            },


            {
                question:
                    "What body part helps spider monkeys move through trees?",

                answers: [
                    "Their ears",
                    "Their feet",
                    "Their prehensile tail",
                    "Their nose"
                ],

                correct: 2
            },


            {
                question:
                    "Which monkey is known for being highly intelligent and dexterous?",

                answers: [
                    "Capuchin",
                    "Howler",
                    "Colobus",
                    "Proboscis"
                ],

                correct: 0
            },


            {
                question:
                    "Where do many monkey species spend much of their time?",

                answers: [
                    "In trees",
                    "Under glaciers",
                    "In deserts",
                    "In caves"
                ],

                correct: 0
            },


            {
                question:
                    "What is one way monkeys can communicate?",

                answers: [
                    "Only through writing",
                    "Sounds and body language",
                    "Radio signals",
                    "None of these"
                ],

                correct: 1
            }

        ];


        let currentQuestion = 0;
        let score = 0;
        let answered = false;


        /* ==================================
           LOAD QUESTION
        ================================== */

        function loadQuestion() {

            answered = false;

            const question =
                questions[currentQuestion];

            document.getElementById("question")
                .textContent =
                question.question;


            document.getElementById("quizCount")
                .textContent =
                `Question ${currentQuestion + 1} of ${questions.length}`;


            document.getElementById("scoreDisplay")
                .textContent =
                `Score: ${score}`;


            document.getElementById("progressBar")
                .style.width =
                `${(currentQuestion / questions.length) * 100}%`;


            const answers =
                document.getElementById("answers");

            answers.innerHTML = "";


            question.answers.forEach(
                (answer, index) => {

                    const button =
                        document.createElement("button");

                    button.className =
                        "answer";

                    button.textContent =
                        answer;

                    button.onclick =
                        () => selectAnswer(index, button);

                    answers.appendChild(button);

                }
            );


            document.getElementById("nextButton")
                .style.display =
                "none";


            document.getElementById("quizMessage")
                .textContent =
                "Select an answer.";

        }


        /* ==================================
           SELECT ANSWER
        ================================== */

        function selectAnswer(
            selected,
            button
        ) {

            if (answered) return;

            answered = true;

            const question =
                questions[currentQuestion];


            const buttons =
                document.querySelectorAll(".answer");


            buttons.forEach(
                (btn, index) => {

                    btn.disabled = true;

                    if (index === question.correct) {
                        btn.classList.add("correct");
                    }

                }
            );


            if (selected === question.correct) {

                score++;

                button.classList.add("correct");

                document.getElementById("quizMessage")
                    .textContent =
                    "🎉 Correct! Great job.";

            } else {

                button.classList.add("wrong");

                document.getElementById("quizMessage")
                    .textContent =
                    "❌ Not quite! The correct answer is highlighted.";

            }


            document.getElementById("scoreDisplay")
                .textContent =
                `Score: ${score}`;


            document.getElementById("nextButton")
                .style.display =
                "block";

        }


        /* ==================================
           NEXT QUESTION
        ================================== */

        function nextQuestion() {

            currentQuestion++;

            if (
                currentQuestion >=
                questions.length
            ) {

                showResults();

                return;

            }

            loadQuestion();

        }


        /* ==================================
           RESULTS
        ================================== */

        function showResults() {

            document.getElementById("quizContent")
                .style.display =
                "none";


            document.getElementById("result")
                .style.display =
                "block";


            document.getElementById("progressBar")
                .style.width =
                "100%";


            document.getElementById("finalScore")
                .textContent =
                `${score}/${questions.length}`;


            let message;

            const percentage =
                score / questions.length;


            if (percentage === 1) {

                message =
                    "🏆 Perfect score! You're officially a Monkey Master.";

            } else if (percentage >= .66) {

                message =
                    "🌿 Excellent work! You really know your monkeys.";

            } else if (percentage >= .5) {

                message =
                    "🐒 Nice job! You've got a solid monkey knowledge base.";

            } else {

                message =
                    "🌱 Keep exploring! There's always more to learn.";

            }


            document.getElementById("resultText")
                .textContent =
                message;

        }


        /* ==================================
           RESTART QUIZ
        ================================== */

        function restartQuiz() {

            currentQuestion = 0;
            score = 0;


            document.getElementById("quizContent")
                .style.display =
                "block";


            document.getElementById("result")
                .style.display =
                "none";


            loadQuestion();

        }


        /* ==================================
           START
        ================================== */

        loadQuestion();

    </script>

